[Unit]
Description=tgproxy admin panel
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/tgproxy-panel serve --db /etc/tgproxy/panel.db --path /p-example/ --listen 127.0.0.1:8443 --mtproto-port 443 --mask-host www.microsoft.com --stats-port 9091
StandardOutput=append:/var/log/tgproxy/panel.log
StandardError=append:/var/log/tgproxy/panel.log
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/tgproxy /var/log/tgproxy /usr/local/bin /etc/systemd/system
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
