[Unit]
Description=tgproxy admin panel
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/tgproxy-panel serve --db /etc/tgproxy/panel.db --path /p-example/ --listen 127.0.0.1:8443 --mtproto-port 443 --mask-host www.microsoft.com --mss-clamp=true --random-padding=true --ja4-log=true --stats-port 9091
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
UMask=0077
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/tgproxy /var/log/tgproxy /usr/local/bin /etc/systemd/system
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
