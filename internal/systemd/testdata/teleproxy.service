[Unit]
Description=Teleproxy MTProto proxy
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/teleproxy --config /etc/tgproxy/teleproxy.toml
StandardOutput=append:/var/log/tgproxy/teleproxy.log
StandardError=append:/var/log/tgproxy/teleproxy.log
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
